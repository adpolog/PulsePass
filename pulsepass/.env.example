# Copy this file to .env (same folder as pom.xml) and fill in the value. .env is git-ignored.
#
# JWT signing key: at least 32 random bytes, Base64-encoded. Generate one with either:
#   openssl rand -base64 32
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Never reuse a key that has been committed to a repository.
PULSEPASS_JWT_SECRET_BASE64=
